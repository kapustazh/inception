listen=YES
listen_ipv6=NO
background=NO
anonymous_enable=NO
local_enable=YES
write_enable=YES
local_umask=022
chroot_local_user=YES
allow_writeable_chroot=YES
local_root=/var/www/html
secure_chroot_dir=/run/vsftpd/empty
pam_service_name=vsftpd
userlist_enable=YES
userlist_deny=NO
userlist_file=/etc/vsftpd.user_list

port_enable=NO
pasv_enable=YES
pasv_addr_resolve=YES
pasv_address=${FTP_PASV_ADDRESS}
pasv_min_port=21100
pasv_max_port=21104

ssl_enable=YES
force_local_logins_ssl=YES
force_local_data_ssl=YES
ssl_sslv2=NO
ssl_sslv3=NO
ssl_tlsv1=NO
# Allow standard FTPS clients that do not reuse the control-channel TLS session.
require_ssl_reuse=NO
rsa_cert_file=/etc/vsftpd/ssl/inception.crt
rsa_private_key_file=/etc/vsftpd/ssl/inception.key
